---
// Bandera pequeña de cada idioma, en SVG (los emojis de bandera no se ven en Windows).
// Inglés lleva la británica porque el inglés de la web es británico (en-GB).
import type { Lang } from '../i18n/langs';
interface Props { lang: Lang; uid: string }
const { lang, uid } = Astro.props;
const id = `fl-${uid}`;
---
<svg class="flag" viewBox="0 0 30 20" width="18" height="12" aria-hidden="true" focusable="false">
  {lang === 'es' && <><rect width="30" height="20" fill="#AA151B" /><rect y="5" width="30" height="10" fill="#F1BF00" /></>}
  {lang === 'de' && <><rect width="30" height="7" fill="#000" /><rect y="6.67" width="30" height="6.67" fill="#DD0000" /><rect y="13.33" width="30" height="6.67" fill="#FFCE00" /></>}
  {lang === 'fr' && <><rect width="10" height="20" fill="#002654" /><rect x="10" width="10" height="20" fill="#fff" /><rect x="20" width="10" height="20" fill="#CE1126" /></>}
  {lang === 'it' && <><rect width="10" height="20" fill="#009246" /><rect x="10" width="10" height="20" fill="#fff" /><rect x="20" width="10" height="20" fill="#CE2B37" /></>}
  {lang === 'en' && (
    <svg viewBox="0 0 60 30" width="30" height="20" preserveAspectRatio="xMidYMid slice">
      <clipPath id={id}><path d="M30,15 h30 v15 z v15 h-30 z h-30 v-15 z v-15 h30 z" /></clipPath>
      <rect width="60" height="30" fill="#012169" />
      <path d="M0,0 L60,30 M60,0 L0,30" stroke="#fff" stroke-width="6" />
      <path d="M0,0 L60,30 M60,0 L0,30" clip-path={`url(#${id})`} stroke="#C8102E" stroke-width="4" />
      <path d="M30,0 v30 M0,15 h60" stroke="#fff" stroke-width="10" />
      <path d="M30,0 v30 M0,15 h60" stroke="#C8102E" stroke-width="6" />
    </svg>
  )}
  <rect x=".5" y=".5" width="29" height="19" fill="none" stroke="rgba(0,0,0,.18)" />
</svg>
