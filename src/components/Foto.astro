---
// Foto optimizada (webp con varios tamaños), siempre en blanco y negro para que el rojo sea el único color.
import { Image } from 'astro:assets';
import { foto } from '../lib/photos';
interface Props { file: string; alt: string; pos?: string; sizes?: string; eager?: boolean; contain?: boolean }
const { file, alt, pos = '50% 50%', sizes = '(min-width: 900px) 50vw, 100vw', eager = false, contain = false } = Astro.props;
const src = foto(file);
const widths = [480, 800, 1200, 1600].filter((w) => w <= src.width).concat(src.width < 480 ? [src.width] : []);
---
<Image
  src={src}
  alt={alt}
  widths={widths}
  sizes={sizes}
  class="ph"
  style={`object-position:${pos};${contain ? 'object-fit:contain' : ''}`}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  decoding="async"
/>
