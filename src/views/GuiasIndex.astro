---
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import Tile from '../components/Tile.astro';
import type { Ctx } from '../i18n/types';
import { GUIAS } from '../data/guias';
import { AMBIENTE, txt } from '../lib/photos';
import { breadcrumbLd } from '../lib/seo';
import { href } from '../lib/routes';
interface Props { c: Ctx }
const { c } = Astro.props;
const { t, lang, d } = c;
const H = (k: string) => href(lang, k);
const crumbs: [string, string][] = [['Calibrario', H('home')], [t.navGuides, H('guias')]];
const [principal, segunda, ...resto] = GUIAS;
const tile = (g: (typeof GUIAS)[number]) => ({ file: AMBIENTE[g.hero].file, alt: txt(AMBIENTE[g.hero], c).alt, t: d.guias[g.key].h1, d: d.guias[g.key].lead, cta: t.readGuide, href: H(`guia:${g.key}`) });
---
<Base c={c} pageKey="guias" title={t.guidesTitle} description={t.guidesDesc} current="guias" jsonld={[breadcrumbLd(crumbs)]}>
  <Crumbs items={crumbs} c={c} />
  <section class="ptitle">
    <h1 class="display">{t.guidesH1}</h1>
    <p class="lead">{t.guidesLead}</p>
  </section>
  <section class="pair">
    <Tile {...tile(principal)} />
    <Tile {...tile(segunda)} />
  </section>
  <h2 class="label">{t.allGuides}</h2>
  <nav class="toc">
    {resto.map((g) => <a href={H(`guia:${g.key}`)}><b>{d.guias[g.key].h1}</b><span>{t.guide}</span><p>{d.guias[g.key].description}</p></a>)}
    <a href={H('glosario')}><b>{t.glH1}</b><span>{t.reference}</span><p>{t.glossaryD}</p></a>
  </nav>
</Base>
